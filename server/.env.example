# Copy this file to server/.env for local development (server/.env is git-ignored).
# These match docker-compose.yml. On the host (Render), set real values as environment variables instead.
DATABASE_URL=postgresql://ttlab:ttlab_dev_password@localhost:5432/ttlab_dev

# Signs the login cookie. At least 32 random characters; generate your own and never commit it:
#   uv run --directory server python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# Local development runs over plain http, so allow the cookie without HTTPS here.
# Leave it unset on the host: the default (true) sends the cookie over HTTPS only.
SESSION_COOKIE_SECURE=false

# The test suite needs its OWN throwaway database (it drops and recreates it). Never the dev one.
# TEST_DATABASE_URL=postgresql://ttlab:ttlab_dev_password@localhost:5432/ttlab_test
